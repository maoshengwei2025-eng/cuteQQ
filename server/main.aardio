// --- 初始化网卡列表 ---
var loadIpAdapters = function(){
    winform.comboIp.clear();
    winform.comboIp.add("0.0.0.0 (所有网卡)");

    // 遍历所有网卡
    for adptInfo in inet.adapter.each() { 

         //获取所有 IP
    	for( ipAddr, strAddr   in adptInfo.eachAddress() ){
    	    if(strAddr != "0.0.0.0") winform.comboIp.add(strAddr + " (" + adptInfo.description + ")");
    	}
    }
    winform.comboIp.selIndex = 1;
}

loadIpAdapters(); // 执行加载

// --- UI 日志功能 ---
var serverLog = function(tag, msg){
    if(!msg) return; 
    var str = tostring(msg);

    // 限制单条日志长度，防止 UI 崩溃
    if(#str > 1000) str = string.left(str, 1000) + "...(过长已截断)";

    var timestamp = time.format("%Y-%m-%d %H:%M:%S");

    // 如果文本太长，先清空一部分
    if(#winform.editLog.text > 100 * 1024){ // 超过 100KB 就清理
        winform.editLog.text = '[系统] 日志已自动清理记录...\r\n';
    }

    winform.editLog.printf("[%s] [%s] %s", timestamp, tag, str);
};

// --- 初始化数据库与服务器核心 ---
var database = db.Database(config.dbPath);
var server = chatServer.ChatServer(database, {
	fileCacheDir = config.fileCacheDir;
	maxSmallFileSize = config.maxSmallFileSize;
	chunkSize = config.chunkSize;
	heartbeatTimeout = config.heartbeatTimeout;
}, serverLog);

var heartCheckTimer = null; // 心跳巡检定时器
var fileSendTimer = null;   // 文件发送消费定时器（驱动工作线程产出的数据帧真正发送出去）

// --- 左侧用户列表（在线用户在前/彩色头像，离线用户在后/灰度头像） ---
var userListCtl = userList(winform.plusUserList);
userListCtl.itemHeight = 60;         // 项目高度
userListCtl.fontSizeName = 11;       // 姓名大小
userListCtl.showOnlineStatus = true; // 显示在线状态小圆点
userListCtl.showTip = true;          // 悬停显示 Tooltip

// 刷新用户列表：从数据库读取全部用户，按在线状态排序
var refreshUserList = function(){
    var rows = database.getAllUsers();
    var data = {};
    for(i=1;#rows;1){
        var row = rows[i];
        table.push(data, {
            name = row.name;
            avatar = row.avatarID : "000.webp";
            sign = row.sign : "";
            status = (row.online == 1) ? "online" : "offline";
            unread = 0;
        });
    }
    userListCtl.setData(data);

    // 统计在线人数并更新标题
    var onlineCount = 0;
    for(i=1;#data;1){
        if(data[i].status == "online") onlineCount++;
    }
    winform.userListTitle.text = "在线用户 (" ++ onlineCount ++ "/" ++ #data ++ ")";
};

refreshUserList(); // 初始加载一次

// 定时刷新用户列表（每 2 秒同步一次在线状态）
winform.addtimer(2000, function(){
    refreshUserList();
});

// --- 启动服务器 ---
winform.btnStart.oncommand = function(id,event){
    var port = tonumber(winform.editPort.text);
    if(!port){
        winform.msgboxErr("请输入有效的端口号");
        return;
    }
    
	// 从组合框中提取 IP 地址（通过模式匹配提取开头的 IP 部分）
    var listenIp = string.match(winform.comboIp.text, "^[\d\.]+") : "0.0.0.0";
    
    if( server.start(listenIp, port) ){
        serverLog("INFO", "服务器已在端口 " ++ port ++ " 启动 (" ++ server.ws.getUrl(,true) ++ ")");
        winform.btnStart.disabledText = ['\uF254','\uF251','\uF252','\uF253','\uF250',text='正在运行...']
        winform.btnStop.disabled = false;
        winform.editPort.disabled = true;
        winform.comboIp.disabled = true;
        winform.btnBroadcast.disabled = false;
        
        // 心跳巡检：清理“启用心跳但长时间无活动”的死连接
        if(!heartCheckTimer){
            heartCheckTimer = winform.addtimer(config.heartbeatCheckInterval, function(){
                server.cleanStaleConnections();
            });
        }
        // 文件发送消费：把工作线程打包好的数据帧真正发送给客户端
        if(!fileSendTimer){
            fileSendTimer = winform.addtimer(30, function(){
                server.consumeSendQueue();
            });
        }
    } else {
        serverLog("ERR", "启动失败，可能是端口被占用或 IP 无效");
    }
}

// --- 停止服务器 ---
winform.btnStop.oncommand = function(id,event){
    var wasRunning = !!server.ws;
    server.stop();
    if(wasRunning) serverLog("INFO", "服务器已停止");
    // 停止心跳巡检与文件发送消费定时器
    if(heartCheckTimer){ winform.killtimer(heartCheckTimer); heartCheckTimer = null; }
    if(fileSendTimer){ winform.killtimer(fileSendTimer); fileSendTimer = null; }
    winform.btnStart.disabled = false;
    winform.btnStop.disabled = true;
    winform.editPort.disabled = false;
    winform.comboIp.disabled = false;
    winform.btnBroadcast.disabled = true;
}

// --- 广播功能 ---
winform.btnBroadcast.oncommand = function(id,event){
    if(!server.ws){
        winform.msgboxErr("服务器未启动");
        return;
    }

    var msgText = string.trim(winform.editBroadcast.text);
    if(!#msgText) {winform.editBroadcast.setFocus(); return;}

    if( server.broadcast(msgText) ){
    	winform.editBroadcast.text = ""; // 清空
    }
}

// 回车发布广播
winform.editBroadcast.onOk = function(){
    winform.btnBroadcast.oncommand();
}

winform.onClose = function(hwnd,message,wParam,lParam){
	if(!winform.msgboxTest("你确定要退出【IM服务器程序】吗?","请确认")) return false; 
    server.stop();
    database.close();
    if(tray) tray.delete();
}

winform.show();
win.loopMessage();
