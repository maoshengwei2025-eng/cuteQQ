/*界面相关{{*/
winform.btnRegidter.skin(plusStyle.buttonLayuiBlue);

var leftBmp = gdip.bitmap( gdip.webp("\res\avatars\000.webp") );   
winform.plusSider.onDrawContent = function(graphics,rc,txtColor,rcContent,foregroundColor,font){
	var l = (rc.width-leftBmp.width)/2;
	var t = (rc.height-leftBmp.height)/2+180;
	var rc2 = ::RECT(l, t, l+leftBmp.width, t+leftBmp.height);
	graphics.drawImageScale( leftBmp, rc2 );
}

winform.plusAvatar.background = leftBmp;

winform.plusAvatarlist.hide = true;
winform.plusAvatarlist.orphanWindow();  //** 让checklist控件浮动（关键代码）

// 初始化 plusView 组件
var imgview = plusView(winform, winform.plusAvatarlist);
imgview.showTitle = false;
imgview.showSubTitle = false;
imgview.autoHeight = false;
imgview.itemWidth = 80;
imgview.itemHeight = 100;

var avatarList = {};
if (_STUDIO_INVOKED/*在开发环境中*/) {
	fsys.enum( "\res\avatars\", ["*.webp"],
    	function(dir,filename,fullpath,findData){ 
        	if(filename){ 
            	..table.push(avatarList, {
                	title = filename;
                	bmp = gdip.bitmap( gdip.webp(fullpath) );
                	path = fullpath;
            	});
        	}
    	} , false/*如果此参数为 false 则忽略子目录*/
	);
}else{
	// 发布环境：从 EXE 资源枚举
    fsys.res.enum( 
        function(module, resType, resName){
            if(..string.startsWith(resName,"/RES/AVATARS/",true)){ //@2必须是"/"分隔符
				table.push(avatarList, {
                	title = io.splitpath("C:"++resName).file;
                	bmp = gdip.bitmap( gdip.webp(resName) );
                	path = resName;
            	});
            }
            return true; 
        }, "RES"
    );
}

imgview.listData = avatarList;        

imgview.onItemClick = function(index){
    var avatarPath = imgview.listData[index].path;
    var bmp= gdip.webp(avatarPath);
    winform.plusAvatar.background = bmp;
    winform.plusAvatar.selectedfileName = string.lower(imgview.listData[index].title);
}


//点击plus控件显示/隐藏checklist控件
var isShow = false;
winform.plusDropdown.oncommand = function(id, event){
    isShow = !isShow;  
    winform.plusDropdown.text = isShow ? '\uF107' : '\uF106';  //切换plus的icon图标
    winform.plusAvatarlist.hide = !isShow;  
    winform.plusAvatarlist.capture = true;
}
winform.plusAvatar.oncommand = function(id,event){
	winform.plusDropdown.oncommand();
}

winform.plusAvatarlist.onMouseUp = function(wParam,lParam){
	winform.plusAvatarlist.hide = true;
    winform.plusDropdown.text = '\uF106';
    isShow = false; 
    winform.plusAvatarlist.capture = false;
}
winform.plusAvatarlist.onRightMouseUp = function(wParam,lParam){
	winform.plusAvatarlist.hide = true;
    winform.plusDropdown.text = '\uF106';
    isShow = false; 
    winform.plusAvatarlist.capture = false;
}
/*}}*/

// 监听消息
var listener = thread.command();
listener.onWsMessage = function(msg){
	select(msg.msgType) {
		case "sys_connected" {
            winform.btnRegidter.disabledText = null;
            // 连接成功了，自动重试发送注册请求（仅在用户已点击过注册时才重发，判空防误发空数据）
            if( winform.regName && winform.regPwd ){
        		var msg = {
        			msgType="register";
        			data={
        				username = winform.regName; 
        				password = winform.regPwd;
        				avatar = winform.plusAvatar.selectedfileName : "000.webp";
        				usersign = winform.txtSign.text;
        			}
        		}
	        	wsHelper.send(msg);  //wsHelper会序列化消息
            }
        }
		case "register_result" {
			if(msg.success){  
            	// 触发主程序的成功回调
            	winform.msgbox(msg.message,  "提示","info");
	    		if(winform.onRegidterSuccess) winform.onRegidterSuccess(msg.data);
        	}
        }
	}
}

// 注册按钮
winform.btnRegidter.oncommand = function(id,event){
	var name = winform.txtName.text;
	if(!#name) {winform.msgbox("请输入用户名", "提示","warn"); winform.txtName.setFocus(); return;}
    var pwd = string.trim( winform.txtPass1.text );  // 明文发送密码
    var pwd2 = string.trim( winform.txtPass2.text) ;  // 明文发送密码
    if(!#pwd || !#pwd2) return winform.msgbox("请输入密码", "提示","warn");
    if(pwd != pwd2) return winform.msgbox("两次输入的密码不一致，请检查", "提示","warn");
    
    //存到窗体属性供 sys_connected 自动重试时使用
    winform.regName = name;
    winform.regPwd = pwd;
    
	// 如果已经连接，直接注册
    if( wsHelper.isConnected() ){
    	var msg = {
    		msgType="register";
    		data={
    			username = name; 
    			password = pwd;
    			avatar = winform.plusAvatar.selectedfileName : "000.webp";
    			usersign =winform.txtSign.text;
    		}
    	};
	    wsHelper.send(msg); 
	}else{
		winform.btnRegidter.disabledText = "正在连接...";
        wsHelper.connect();
	}
}

//拦截Email输入框回车键
winform.txtEmail.onOk = function(){
    winform.btnRegidter.oncommand();
}

return winform;