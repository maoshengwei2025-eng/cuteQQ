// 自绘当前用户头像
winform.plusUserAvatar.onDrawBackground = function(graphics,rc,backgroundColor,foregroundColor){	
	if(!winform.curAvatarId) return;
	var bmp = gdip.bitmap( gdip.webp("\res\avatars\" ++ winform.curAvatarId) );
	var path = ..gdip.path();
    var borderPen = ..gdip.pen(0xFFBFBFBF, 4); 
    //path.addEllipse(rc.inflate(-4,-4).xywh()); //圆形轮廓
    path.addRoundRect(rc.inflate(-4,-4),5);
    graphics.drawPath(borderPen, path);
    graphics.setClipPath(path); 
    graphics.clear(0xFFFFFFFF)
    graphics.drawImageScale(bmp, rc);
    path.delete();  bmp.delete();  borderPen.delete()
}

