winform.add(
btnLogin={cls="plus";text="登 录";left=200;top=384;right=312;bottom=424;bgcolor=0x8FB2B0;default=1;font=LOGFONT(h=-13);iconStyle={align="left";font=LOGFONT(h=-13;name='FontAwesome');padding={left=20}};notify=1;z=5};
btnRegister={cls="plus";text="注 册";left=56;top=384;right=168;bottom=424;bgcolor=0x8FB2B0;font=LOGFONT(h=-13);iconStyle={align="left";font=LOGFONT(h=-13;name='FontAwesome');padding={left=20}};notify=1;z=2};
btnSetting={cls="plus";text='\uF013';left=337;top=443;right=359;bottom=464;anchors={right=1;bottom=1};color=0x800000;font=LOGFONT(h=-14;name='FontAwesome');notify=1;z=6};
plusAvatar={cls="plus";left=120;top=80;right=248;bottom=208;repeat="scale";z=1};
txtPass={cls="plus";left=80;top=312;right=288;bottom=344;align="left";anchors={left=1;top=1;right=1};bgcolor=0xFFFFFF;border={color=0x808080;radius=20;width=1};editable=1;font=LOGFONT(h=-13);password=1;tabstop=1;textPadding={left=45;top=6};z=4};
txtUser={cls="plus";left=80;top=256;right=288;bottom=288;align="left";anchors={left=1;top=1;right=1};bgcolor=0xFFFFFF;border={color=0x808080;radius=20;width=1};editable="edit";font=LOGFONT(h=-13);tabstop=1;textPadding={left=45;top=6;right=10;bottom=4};z=3}
)
/*}}*/

win.ui.simpleWindow(winform);

